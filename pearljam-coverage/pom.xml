<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.insee.pearljam</groupId>
        <artifactId>pearljam-back-office-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pearljam-coverage</artifactId>
    <packaging>pom</packaging>
    <name>Pearl-Jam Coverage</name>

    <profiles>
        <profile>
            <id>coverage</id>
            <dependencies>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-domain-model</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-domain</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-shared-dto</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-shared-persistence-model</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-infrastructure-persistence</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-infrastructure-http</artifactId>
                </dependency>
                <dependency>
                    <groupId>fr.insee.pearljam</groupId>
                    <artifactId>pearljam-infrastructure-security</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.14</version>
                        <executions>
                            <execution>
                                <id>report-aggregate</id>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                                <configuration>
                                    <includeCurrentProject>true</includeCurrentProject>
                                </configuration>
                                <phase>verify</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
